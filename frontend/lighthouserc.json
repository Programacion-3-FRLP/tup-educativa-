{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/tup-educativa-/browser",
      "url": ["http://localhost/"],
      "isSinglePageApplication": true,
      "numberOfRuns": 1
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse",
      "reportFilenamePattern": "lighthouse-report.%%EXTENSION%%"
    }
  }
}
